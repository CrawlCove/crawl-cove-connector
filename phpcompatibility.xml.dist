<?xml version="1.0"?>
<ruleset name="crawl-cove-connector-phpcompat">
	<description>Enforces the plugin's PHP 7.4 syntax floor (CLAUDE.md engineering rule) — kept separate from phpcs.xml.dist so PHPCompatibility's sniffs don't interact with WordPress-Extra's.</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/wordpress-org/*</exclude-pattern>

	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
