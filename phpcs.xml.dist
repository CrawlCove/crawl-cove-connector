<?xml version="1.0"?>
<ruleset name="crawl-cove-connector">
	<description>WordPress-Extra (incl. Core + Docs) ruleset for the plugin's own source. wordpress.org reviewers run this.</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/tests/integration/.cache/*</exclude-pattern>
	<exclude-pattern>*/tests/integration/.site/*</exclude-pattern>
	<exclude-pattern>*/wordpress-org/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<config name="minimum_supported_wp_version" value="6.2"/>
	<rule ref="WordPress-Extra">
		<!-- File-per-class naming isn't followed (class-ccc-*.php holds one class, matches WP convention already). -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress-Docs"/>
</ruleset>
